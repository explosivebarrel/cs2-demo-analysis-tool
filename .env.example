# CS2 Demo Analyzer — overrides for docker-compose.
# Copy next to docker-compose.yml and adjust:
#   cp .env.example .env
# Values apply on container (re)creation:
#   docker compose up -d backend
#
# NOTE: CS2_DATA_DIR / CS2_INBOX_DIR are intentionally fixed in
# docker-compose.yml — they are tied to the volume mounts.

# --- Analysis ------------------------------------------------------------
# Parallel analysis jobs; 0 = unlimited
#CS2_MAX_CONCURRENT_ANALYZES=0
# Replay timeline sample step, seconds (~8 frames/sec; smaller = smoother, heavier payload)
#CS2_FRAME_SECONDS=0.125
# Upload size cap in MB (checked on the unpacked file for .zst/.gz)
#CS2_MAX_UPLOAD_MB=1200

# --- Auto-import: watch folders -------------------------------------------
# ':'-separated paths *inside the backend container*.
# Mount host folders as volumes in docker-compose.yml first, e.g.:
#   - C:/Users/you/cs2-demos:/watch:ro
# then set CS2_WATCH_DIRS=/watch (several dirs: /watch:/watch2)
# The first scan only remembers existing files — no mass import on startup.
#CS2_WATCH_DIRS=
#CS2_WATCH_POLL_SEC=20

# --- Auto-import: FACEIT ----------------------------------------------------
# Free key: FACEIT Developer Portal -> App Studio -> your app -> API Keys
# Player id: GUID from your FACEIT profile page URL
#CS2_FACEIT_API_KEY=
#CS2_FACEIT_PLAYER_ID=
#CS2_FACEIT_POLL_SEC=300
